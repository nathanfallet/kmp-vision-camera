<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application>
        <!-- Captures the application context and the current activity, so VisionCamera needs no setup. -->
        <provider
            android:name="me.nathanfallet.visioncamera.VisionCameraInitializer"
            android:authorities="${applicationId}.visioncamera-initializer"
            android:exported="false" />
    </application>

</manifest>
