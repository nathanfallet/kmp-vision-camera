<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Like VisionCameraLocation V5, the app declares ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION itself. -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.network"
        android:required="false" />

    <application>
        <!-- Captures the application context and the current activity, so the location module needs no setup. -->
        <provider
            android:name="me.nathanfallet.visioncamera.location.LocationInitializer"
            android:authorities="${applicationId}.visioncamera-location-initializer"
            android:exported="false" />
    </application>

</manifest>
